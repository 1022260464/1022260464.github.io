---
import LandingLayout from "../layouts/LandingLayout.astro";
import Planet from "../components/Planet.astro";
import Spark from "../components/Spark.astro";

const orbits = [
	{
		className: "orbit-blue",
		size: "52%",
		duration: 38,
		direction: "normal",
		delay: "-9s",
		planetSize: "1.12rem",
		secondPlanetSize: "0.7rem",
		primaryPlanet: "ocean",
		secondaryPlanet: "moon",
	},
	{
		className: "orbit-pink",
		size: "77%",
		duration: 54,
		direction: "reverse",
		delay: "-21s",
		planetSize: "1.45rem",
		secondPlanetSize: "0.82rem",
		primaryPlanet: "rose",
		secondaryPlanet: "ember",
	},
	{
		className: "orbit-gold",
		size: "100%",
		duration: 72,
		direction: "normal",
		delay: "-34s",
		planetSize: "0.88rem",
		secondPlanetSize: "1.18rem",
		primaryPlanet: "saturn",
		secondaryPlanet: "moon",
	},
] as const;
---

<LandingLayout>
	<div class="landing-shell" data-landing>
		<header class="landing-header">
			<a class="landing-brand" href="/home/" aria-label="进入 0x330 首页">
				<span>0x330</span>
				<Spark size={18} delay={-4} />
			</a>
			<p class="landing-status">
				<i></i>
				Learning in public / 2026
			</p>
		</header>

		<main class="landing-main">
			<section class="landing-copy" aria-labelledby="landing-title">
				<p
					class="landing-kicker"
					data-typewriter
					data-typewriter-delay="220"
				>
					Code × Life × AI
				</p>
				<h1 id="landing-title" data-landing-reveal>
					<span>把代码写下</span>
					<span>把生活留住</span>
				</h1>
				<p
					class="landing-lede"
					data-typewriter
					data-typewriter-delay="920"
				>
					这里记录代码学习、日常生活，以及前端、后端、算法和 AI 的实践笔记。
				</p>
				<a class="enter-site" href="/home/" data-landing-reveal>
					<span>进入网站</span>
					<i>↗</i>
				</a>
			</section>

			<div class="landing-scene" data-landing-scene aria-hidden="true">
				<p class="scene-label">Learning orbit / 03</p>
				<div class="scene-parallax" data-orbit-parallax>
					{
						orbits.map((orbit) => (
							<div
								class:list={["orbit-track", orbit.className]}
								style={`--orbit-size: ${orbit.size}; --orbit-duration: ${orbit.duration}s; --orbit-direction: ${orbit.direction}; --orbit-delay: ${orbit.delay}; --planet-size: ${orbit.planetSize}; --second-planet-size: ${orbit.secondPlanetSize};`}
							>
								<span class="orbit-line"></span>
								<Planet
									variant={orbit.primaryPlanet}
									class="planet-primary"
								/>
								<Planet
									variant={orbit.secondaryPlanet}
									class="planet-secondary"
								/>
							</div>
						))
					}

					<div class="scene-center">
						<Spark size={34} delay={-6} />
						<span>0x330</span>
					</div>
				</div>
				<div class="scene-floor" aria-hidden="true"></div>
			</div>
		</main>

		<footer class="landing-footer">
			<p>Notes on code, life and AI</p>
			<p>Personal space — {new Date().getFullYear()}</p>
		</footer>
	</div>
</LandingLayout>

<script>
	import "../scripts/site-motion";
	import "../scripts/landing-motion";
</script>

<style>
	:global(body.landing-body) {
		overflow: hidden;
		background: var(--paper);
	}

	.landing-shell {
		--scene-ink: #262a24;
		--scene-muted: #73786f;
		position: relative;
		isolation: isolate;
		width: 100%;
		height: 100svh;
		min-height: 620px;
		overflow: hidden;
		color: var(--ink);
		background:
			linear-gradient(rgb(17 19 15 / 0.032) 1px, transparent 1px),
			linear-gradient(90deg, rgb(17 19 15 / 0.032) 1px, transparent 1px),
			var(--paper);
		background-size: 28px 28px;
	}

	.landing-shell::before {
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			radial-gradient(circle at 73% 48%, rgb(255 255 255 / 0.9), transparent 28%),
			linear-gradient(180deg, rgb(248 249 246 / 0.05), rgb(248 249 246 / 0.44));
		content: "";
		pointer-events: none;
	}

	.landing-header,
	.landing-footer {
		position: absolute;
		right: clamp(22px, 4vw, 64px);
		left: clamp(22px, 4vw, 64px);
		z-index: 4;
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-family: var(--font-mono);
		font-size: 0.64rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.landing-header {
		top: 28px;
	}

	.landing-brand {
		display: inline-flex;
		gap: 9px;
		align-items: center;
		padding: 10px 14px;
		color: white;
		background: var(--ink);
		border-radius: 999px;
		font-family: var(--font-sans);
		font-size: 0.84rem;
		font-weight: 760;
		letter-spacing: 0;
	}

	.landing-brand :global(svg) {
		overflow: visible;
	}

	.landing-status {
		display: flex;
		gap: 9px;
		align-items: center;
		margin: 0;
		color: var(--faint);
	}

	.landing-status i {
		width: 6px;
		height: 6px;
		background: #35a85e;
		border-radius: 50%;
		box-shadow: 0 0 0 3px rgb(53 168 94 / 0.1);
	}

	.landing-main {
		position: relative;
		z-index: 2;
		display: grid;
		grid-template-columns: minmax(0, 0.84fr) minmax(440px, 1.16fr);
		gap: 24px;
		align-items: center;
		width: min(100%, 1500px);
		height: 100%;
		margin: 0 auto;
		padding: 90px clamp(28px, 6vw, 96px) 72px;
	}

	.landing-copy {
		position: relative;
		z-index: 3;
		max-width: 620px;
	}

	:global(html.motion-enabled) [data-landing-reveal] {
		opacity: 0;
	}

	.landing-kicker {
		margin: 0 0 28px;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.67rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.landing-copy h1 {
		margin: 0;
		font-size: clamp(4.2rem, 7.8vw, 8.2rem);
		font-weight: 740;
		letter-spacing: -0.075em;
		line-height: 0.88;
	}

	.landing-copy h1 span {
		display: block;
		white-space: nowrap;
	}

	.landing-copy h1 span:last-child {
		color: #7b6ee7;
	}

	.landing-lede {
		max-width: 430px;
		margin: 34px 0 0;
		color: var(--muted);
		font-size: 0.98rem;
		line-height: 1.8;
	}

	.enter-site {
		display: inline-flex;
		gap: 34px;
		align-items: center;
		justify-content: space-between;
		min-width: 190px;
		margin-top: 36px;
		padding: 14px 16px 14px 20px;
		color: white;
		background: var(--ink);
		border: 1px solid var(--ink);
		border-radius: 999px;
		font-size: 0.83rem;
		font-weight: 700;
		transition:
			color 180ms ease,
			background 180ms ease,
			transform 180ms ease;
	}

	.enter-site i {
		font-family: var(--font-mono);
		font-size: 0.95rem;
		font-style: normal;
	}

	.enter-site:hover {
		color: var(--ink);
		background: transparent;
		transform: translateY(-2px);
	}

	.landing-scene {
		position: relative;
		justify-self: center;
		width: min(46vw, 680px);
		aspect-ratio: 1;
		cursor: crosshair;
		touch-action: none;
	}

	.scene-label {
		position: absolute;
		top: 3%;
		left: 5%;
		z-index: 3;
		margin: 0;
		color: var(--faint);
		font-family: var(--font-mono);
		font-size: 0.59rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.scene-parallax {
		position: absolute;
		inset: 0;
		will-change: translate;
	}

	.orbit-track {
		position: absolute;
		top: 50%;
		left: 50%;
		width: var(--orbit-size);
		aspect-ratio: 1;
		border-radius: 50%;
		translate: -50% -50%;
		animation: orbit-spin var(--orbit-duration) linear infinite;
		animation-direction: var(--orbit-direction);
		animation-delay: var(--orbit-delay);
		transition: scale 480ms cubic-bezier(0.32, 0.72, 0, 1);
	}

	.orbit-line {
		position: absolute;
		inset: 0;
		display: block;
		border: 1px solid rgb(17 19 15 / 0.16);
		border-radius: 50%;
	}

	.orbit-pink .orbit-line {
		border-color: rgb(17 19 15 / 0.19);
	}

	.orbit-gold .orbit-line {
		border-color: rgb(17 19 15 / 0.23);
	}

	.orbit-blue {
		--counter-direction: reverse;
	}

	.orbit-pink {
		--counter-direction: normal;
	}

	.orbit-gold {
		--counter-direction: reverse;
	}

	.scene-center {
		position: absolute;
		top: 50%;
		left: 50%;
		z-index: 2;
		display: grid;
		width: clamp(78px, 9vw, 108px);
		aspect-ratio: 1;
		place-items: center;
		background: var(--ink);
		border: 1px solid rgb(17 19 15 / 0.25);
		border-radius: 50%;
		box-shadow:
			0 0 0 14px rgb(255 255 255 / 0.32),
			0 18px 50px rgb(17 19 15 / 0.12);
		translate: -50% -50%;
		transition: scale 480ms cubic-bezier(0.32, 0.72, 0, 1);
	}

	.scene-center :global(svg) {
		position: absolute;
		width: 36%;
		height: 36%;
		opacity: 0.32;
	}

	.scene-center span {
		position: relative;
		z-index: 1;
		color: white;
		font-family: var(--font-mono);
		font-size: clamp(0.58rem, 0.75vw, 0.68rem);
		font-weight: 650;
		letter-spacing: 0.08em;
	}

	.scene-floor {
		position: absolute;
		right: 15%;
		bottom: 5%;
		left: 15%;
		height: 12%;
		background: radial-gradient(ellipse, rgb(17 19 15 / 0.08), transparent 68%);
		filter: blur(8px);
	}

	.landing-scene.is-contracted .orbit-track {
		scale: 0.82;
	}

	.landing-scene.is-contracted .scene-center {
		scale: 1.08;
	}

	.landing-footer {
		bottom: 26px;
		color: rgb(17 19 15 / 0.39);
	}

	.landing-footer p {
		margin: 0;
	}

	@keyframes orbit-spin {
		to {
			rotate: 360deg;
		}
	}

	@media (max-width: 1080px) {
		.landing-main {
			grid-template-columns: 1fr;
			align-content: center;
		}

		.landing-copy {
			max-width: 760px;
		}

		.landing-scene {
			position: absolute;
			top: 49%;
			right: -7%;
			width: min(73vw, 620px);
			opacity: 0.76;
			translate: 0 -50%;
		}
	}

	@media (max-width: 700px) {
		.landing-shell {
			min-height: 560px;
		}

		.landing-header {
			top: 18px;
		}

		.landing-status {
			font-size: 0.56rem;
		}

		.landing-main {
			align-content: end;
			padding: 96px 20px 82px;
		}

		.landing-copy h1 {
			font-size: clamp(3.8rem, 17vw, 5.4rem);
		}

		.landing-lede {
			max-width: 330px;
			margin-top: 24px;
			font-size: 0.9rem;
		}

		.enter-site {
			margin-top: 26px;
		}

		.landing-scene {
			top: 34%;
			right: -12%;
			width: 92vw;
			opacity: 0.72;
		}

		.scene-label {
			display: none;
		}

		.landing-footer p:first-child {
			display: none;
		}
	}

	@media (max-height: 760px) and (min-width: 701px) {
		.landing-footer p:first-child {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.orbit-track,
		.planet {
			animation: none;
		}
	}
</style>
