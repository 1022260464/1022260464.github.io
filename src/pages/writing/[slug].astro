---
import {
  getCollection,
  render,
  type CollectionEntry,
} from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ReadingProgress from "../../components/ReadingProgress.astro";
import { site } from "../../lib/site";

export async function getStaticPaths() {
  const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  const postById = new Map(posts.map((post) => [post.id, post]));

  return posts.map((post, index) => {
    const ancestors: CollectionEntry<"blog">[] = [];
    const visited = new Set<string>([post.id]);
    let current = post;

    while (current.data.parent) {
      const parent = postById.get(current.data.parent);
      if (!parent || visited.has(parent.id)) break;
      ancestors.unshift(parent);
      visited.add(parent.id);
      current = parent;
    }

    return {
      params: { slug: post.id },
      props: {
        post,
        ancestors,
        parent: ancestors.at(-1),
        children: posts
          .filter((candidate) => candidate.data.parent === post.id)
          .sort((a, b) => a.data.order - b.data.order),
        newer: posts[index - 1],
        older: posts[index + 1],
      },
    };
  });
}

interface Props {
  post: CollectionEntry<"blog">;
  ancestors: CollectionEntry<"blog">[];
  parent?: CollectionEntry<"blog">;
  children: CollectionEntry<"blog">[];
  newer?: CollectionEntry<"blog">;
  older?: CollectionEntry<"blog">;
}

const { post, ancestors, parent, children, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const dateFormat = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const displayDate = dateFormat.format(post.data.pubDate);
const updatedDate = post.data.updatedDate
  ? dateFormat.format(post.data.updatedDate)
  : null;
---

<Layout
  title={`${post.data.title} — ${site.name}`}
  description={post.data.description}
  type="article"
>
  <ReadingProgress />
  <article class="article-shell">
    <header class="article-header">
      <nav class="article-path" aria-label="文章层级" data-enter>
        <a href="/writing">文章</a>
        <span aria-hidden="true">/</span>
        <span>{post.data.category}</span>
        {
          ancestors.map((ancestor) => (
            <>
              <span aria-hidden="true">/</span>
              <a href={`/writing/${ancestor.id}`}>{ancestor.data.title}</a>
            </>
          ))
        }
      </nav>
      <div class="article-kicker" data-enter>
        <time datetime={post.data.pubDate.toISOString()}>{displayDate}</time>
        <span aria-hidden="true">/</span>
        <span>{post.data.tags[0] ?? "写作"}</span>
      </div>
      <h1 data-split="chars">{post.data.title}</h1>
      {post.data.description && (
        <p class="article-description" data-enter>{post.data.description}</p>
      )}
      <div class="article-meta" data-enter>
        <span>文 / {site.name}</span>
        <span>{Math.max(1, Math.ceil((post.body ?? "").length / 500))} 分钟阅读</span>
      </div>
    </header>

    {
      post.data.cover && (
        <figure class="article-cover" data-cover>
          <img
            src={post.data.cover}
            alt={post.data.coverAlt ?? ""}
            loading="eager"
          />
        </figure>
      )
    }

    {
      headings.length > 0 && (
        <aside class="toc" aria-label="文章目录" data-reveal>
          <p>On this page</p>
          <ol>
            {headings
              .filter((heading) => heading.depth <= 3)
              .map((heading) => (
                <li>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
          </ol>
        </aside>
      )
    }

    <div class="article-grid">
      <div class="article-body prose">
        <Content />
      </div>
      <aside class="article-aside" data-reveal>
        <p class="eyebrow">Filed under</p>
        <div class="tag-list">
          {post.data.tags.map((tag) => <span>{tag}</span>)}
        </div>
        {
          (parent || children.length > 0) && (
            <section class="article-hierarchy">
              <p class="eyebrow">In this collection</p>
              {parent && (
                <a href={`/writing/${parent.id}`}>
                  <span>上级</span>
                  <strong>{parent.data.title}</strong>
                </a>
              )}
              {
                children.map((child, index) => (
                  <a href={`/writing/${child.id}`}>
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <strong>{child.data.title}</strong>
                  </a>
                ))
              }
            </section>
          )
        }
        {updatedDate && <p class="updated">更新于 {updatedDate}</p>}
      </aside>
    </div>

    <nav class="article-nav" aria-label="文章翻页" data-reveal>
      {
        older ? (
          <a href={`/writing/${older.id}`}>
            <span>上一篇</span>
            <strong>{older.data.title}</strong>
          </a>
        ) : (
          <div />
        )
      }
      {
        newer ? (
          <a class="next" href={`/writing/${newer.id}`}>
            <span>下一篇</span>
            <strong>{newer.data.title}</strong>
          </a>
        ) : (
          <div />
        )
      }
    </nav>
  </article>
</Layout>

<style>
  .article-shell {
    width: min(100%, 1080px);
    margin: 0 auto;
    padding: 72px 0 54px;
  }

  .article-header {
    max-width: 940px;
    padding-bottom: 52px;
    border-bottom: 1px solid var(--line);
  }

  .article-path {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.69rem;
  }

  .article-path a:hover {
    color: var(--ink);
  }

  .article-path span:last-child {
    color: var(--faint);
  }

  .article-kicker {
    display: flex;
    gap: 10px;
    margin-top: 58px;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 920px;
    margin: 18px 0 22px;
    font-size: clamp(3rem, 7vw, 6.2rem);
    font-weight: 750;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .article-description {
    max-width: 680px;
    margin: 0;
    color: var(--muted);
    font-size: 1.12rem;
    line-height: 1.7;
  }

  .article-meta {
    display: flex;
    gap: 24px;
    margin-top: 28px;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  .article-cover {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 8;
    margin: 38px 0 4px;
    background: var(--paper-strong);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .article-cover img {
    width: 100%;
    height: 112%;
    object-fit: cover;
    transform-origin: center;
    will-change: transform;
  }

  .toc {
    float: right;
    width: 190px;
    margin: 54px 0 28px 42px;
    padding: 15px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .toc p {
    margin: 0 0 12px;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
  }

  .toc ol {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc a {
    color: var(--muted);
    font-size: 0.74rem;
    line-height: 1.4;
  }

  .toc a:hover {
    color: var(--ink);
  }

  .article-grid {
    display: grid;
    grid-template-columns: minmax(0, 760px) minmax(130px, 1fr);
    gap: 58px;
    padding-top: 52px;
  }

  .article-body {
    min-width: 0;
  }

  .article-aside {
    align-self: start;
    padding-top: 4px;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 13px;
  }

  .tag-list span {
    padding: 5px 8px;
    color: var(--muted);
    background: var(--paper-strong);
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.67rem;
  }

  .article-hierarchy {
    display: grid;
    gap: 0;
    margin-top: 28px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .article-hierarchy > p {
    margin-bottom: 10px;
  }

  .article-hierarchy a {
    display: grid;
    gap: 4px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }

  .article-hierarchy a:hover strong {
    color: var(--blue);
  }

  .article-hierarchy span {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.52rem;
    text-transform: uppercase;
  }

  .article-hierarchy strong {
    font-size: 0.7rem;
    font-weight: 550;
    line-height: 1.45;
  }

  .updated {
    margin-top: 26px;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.61rem;
  }

  .article-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 76px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .article-nav a {
    display: grid;
    gap: 8px;
    padding: 17px;
    border: 1px solid transparent;
    border-radius: var(--radius);
    transition:
      background 160ms ease,
      border-color 160ms ease;
  }

  .article-nav a:hover {
    background: rgb(255 255 255 / 0.65);
    border-color: var(--line);
  }

  .article-nav .next {
    text-align: right;
  }

  .article-nav span {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
  }

  .article-nav strong {
    font-size: 0.91rem;
    font-weight: 650;
    line-height: 1.45;
  }

  @media (max-width: 900px) {
    .toc {
      display: none;
    }

    .article-grid {
      display: block;
    }

    .article-aside {
      margin-top: 40px;
      padding-top: 20px;
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 600px) {
    .article-shell {
      padding-top: 32px;
    }

    .article-header {
      padding-bottom: 38px;
    }

    .article-kicker {
      margin-top: 42px;
    }

    h1 {
      font-size: clamp(2.55rem, 13vw, 4rem);
    }

    .article-description {
      font-size: 1rem;
    }

    .article-grid {
      padding-top: 38px;
    }

    .article-cover {
      aspect-ratio: 4 / 3;
      margin-top: 30px;
    }

    .article-nav {
      grid-template-columns: 1fr;
    }

    .article-nav .next {
      text-align: left;
    }
  }
</style>
