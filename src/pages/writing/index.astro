---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import WritingArchive from "../../components/WritingArchive";
import { site } from "../../lib/site";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const archivePosts = posts.map((post) => ({
  id: post.id,
  title: post.data.title,
  description: post.data.description,
  date: post.data.pubDate.toISOString(),
  updatedDate: post.data.updatedDate?.toISOString(),
  tags: post.data.tags,
  category: post.data.category,
  parent: post.data.parent,
  order: post.data.order,
  readingMinutes: Math.max(
    1,
    Math.ceil((post.body ?? "").length / 500),
  ),
}));
---

<Layout
  title={`笔记 — ${site.name}`}
  description="记录前端、后端、算法、AI 与日常生活的个人学习笔记。"
>
  <div class="page-shell listing-page">
    <header class="page-header">
      <p class="eyebrow" data-enter>Notes / Archive</p>
      <div class="page-title-row">
        <h1>
          <span data-enter>学习与生活</span>
          <span data-enter>都写下来。</span>
        </h1>
        <p data-typewriter>
          前端、后端、算法、AI 与日常生活的学习笔记。按内容层级、时间清单或发布日期浏览。
        </p>
      </div>
    </header>

    <WritingArchive client:load posts={archivePosts} />
  </div>
</Layout>

<style>
  .listing-page {
    padding-top: 78px;
  }

  .page-header {
    padding-bottom: 76px;
  }

  .page-title-row {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(240px, 0.55fr);
    gap: 50px;
    align-items: end;
    margin-top: 36px;
  }

  h1 {
    margin: 0;
    font-size: clamp(4rem, 9vw, 7.5rem);
    font-weight: 760;
    letter-spacing: -0.055em;
    line-height: 0.86;
  }

  h1 span {
    display: block;
  }

  .page-title-row > p {
    max-width: 280px;
    margin: 0 0 4px;
    color: var(--muted);
    font-size: 0.93rem;
    line-height: 1.7;
  }

  @media (max-width: 760px) {
    .listing-page {
      padding-top: 34px;
    }

    .page-header {
      padding-bottom: 54px;
    }

    .page-title-row {
      grid-template-columns: 1fr;
      gap: 24px;
      margin-top: 28px;
    }

    h1 {
      font-size: clamp(3.6rem, 20vw, 5.5rem);
    }
  }
</style>
