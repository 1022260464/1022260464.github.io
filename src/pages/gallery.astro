---
import Layout from "../layouts/Layout.astro";
import ShareGallery from "../components/gallery/ShareGallery";
import { countShareNodes, getShareYears, shares } from "../lib/shares";
import { site } from "../lib/site";

const totalShares = countShareNodes(shares);
const shareYears = getShareYears(shares).join(" / ");
---

<Layout
  title={`分享 — ${site.name}`}
  description="关于设计、代码、工具与日常灵感的个人分享收藏。"
>
  <div class="page-shell gallery-page">
    <header class="gallery-header">
      <p class="eyebrow" data-enter>Gallery / Personal archive</p>
      <div class="gallery-heading">
        <h1>
          <span data-enter>私藏的</span>
          <span data-enter>灵感。</span>
        </h1>
        <div class="gallery-intro" data-enter>
          <p>
            这里放设计、代码、工具和日常里值得再次打开的东西。
            它们不追求完整，只记录此刻真正打动我的部分。
          </p>
          <p class="gallery-count">
            <span>{String(totalShares).padStart(2, "0")}</span>
            {shares.length} collections · {shareYears}
          </p>
        </div>
      </div>
    </header>

    <ShareGallery client:load shares={shares} />

    <footer class="gallery-footer" data-reveal>
      <p>Personal collection / Updated slowly</p>
      <a href={site.github} target="_blank" rel="noreferrer">
        更多记录在 GitHub ↗
      </a>
    </footer>
  </div>
</Layout>

<style>
  .gallery-page {
    width: min(100%, 1240px);
    padding-top: 72px;
  }

  .gallery-header {
    padding-bottom: 58px;
  }

  .gallery-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(250px, 0.65fr);
    gap: 64px;
    align-items: end;
    margin-top: 36px;
  }

  h1 {
    margin: 0;
    font-size: clamp(4.8rem, 10vw, 9rem);
    font-weight: 760;
    letter-spacing: -0.065em;
    line-height: 0.82;
  }

  h1 span {
    display: block;
  }

  .gallery-intro {
    padding-bottom: 5px;
  }

  .gallery-intro > p:first-child {
    max-width: 350px;
    margin: 0;
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.78;
  }

  .gallery-count {
    display: flex;
    gap: 12px;
    align-items: center;
    margin: 24px 0 0;
    padding-top: 14px;
    color: var(--faint);
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .gallery-count span {
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 700;
  }

  .gallery-footer {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 72px;
    padding: 20px 0 10px;
    color: var(--faint);
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .gallery-footer p {
    margin: 0;
  }

  .gallery-footer a:hover {
    color: var(--ink);
  }

  @media (max-width: 980px) {
    .gallery-page {
      padding-top: 64px;
    }
  }

  @media (max-width: 760px) {
    .gallery-page {
      padding-top: 34px;
    }

    .gallery-header {
      padding-bottom: 42px;
    }

    .gallery-heading {
      grid-template-columns: 1fr;
      gap: 30px;
      margin-top: 28px;
    }

    h1 {
      font-size: clamp(4.1rem, 23vw, 6.4rem);
    }

    .gallery-intro > p:first-child {
      max-width: 520px;
    }

    .gallery-footer {
      display: grid;
      margin-top: 52px;
    }
  }
</style>
