---
import Layout from "../layouts/Layout.astro";
import MotionPath from "../components/MotionPath";
import { site } from "../lib/site";
---

<Layout
  title={`关于 — ${site.name}`}
  description="关于我，以及这个记录代码学习、日常生活和技术笔记的个人网站。"
>
  <div class="page-shell about-page">
    <header class="about-hero">
      <div>
        <p class="eyebrow" data-enter>About / Learning in public</p>
        <h1>
          <span data-enter>记录学习，</span>
          <span data-enter>也记录生活。</span>
        </h1>
      </div>
      <div class="orbit-decoration" aria-hidden="true" data-enter>
        <MotionPath client:load />
      </div>
    </header>

    <section class="about-intro" data-reveal>
      <p class="section-index">01 / 关于这里</p>
      <div>
        <p class="lead" data-typewriter>
          这是我的个人网站，用来记录代码学习、日常生活，以及前端、后端、算法和 AI 的知识与实践。
        </p>
        <p data-typewriter data-typewriter-delay="2160">
          这里既会有学习过程中的技术笔记，也会留下阅读、生活片段和一些还没有答案的思考。
          我会持续整理那些经过实践、验证和反复回看的内容。
        </p>
      </div>
    </section>

    <section class="about-grid">
      <article data-reveal data-tilt>
        <p class="section-index">02 / 此刻</p>
        <h2>正在做的事</h2>
        <ul>
          <li><span>01</span>学习并整理前端与后端开发实践</li>
          <li><span>02</span>记录算法、数据结构与 AI 基础学习</li>
          <li><span>03</span>分享日常、阅读与生活中的观察</li>
          <li><span>04</span>把零散经验整理成可以回看的笔记</li>
        </ul>
      </article>
      <article data-reveal data-tilt>
        <p class="section-index">03 / 关键词</p>
        <h2>最近关注</h2>
        <div class="keyword-cloud">
          <span>Frontend</span>
          <span>Backend</span>
          <span>Algorithms</span>
          <span>AI</span>
          <span>Learning in public</span>
          <span>Daily notes</span>
        </div>
      </article>
    </section>

    <section class="contact-panel" data-reveal>
      <div>
        <p class="eyebrow">Get in touch</p>
        <h2>有想法，<br />可以聊聊。</h2>
      </div>
      <div class="contact-links">
        <a href={site.email} data-magnetic>
          <span>Email</span>
          <strong>1022260464@qq.com</strong>
          <i>↗</i>
        </a>
        <a href={site.github} target="_blank" rel="noreferrer" data-magnetic>
          <span>GitHub</span>
          <strong>@1022260464</strong>
          <i>↗</i>
        </a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .about-page {
    padding-top: 78px;
  }

  .about-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(220px, 0.6fr);
    gap: 48px;
    align-items: center;
    min-height: 470px;
  }

  h1 {
    margin: 32px 0 0;
    font-size: clamp(3.4rem, 6.8vw, 5.8rem);
    font-weight: 750;
    letter-spacing: 0;
    line-height: 0.94;
  }

  h1 span {
    display: block;
    white-space: nowrap;
  }

  .orbit-decoration {
    justify-self: end;
    width: min(100%, 390px);
    aspect-ratio: 451 / 437;
  }

  .about-intro {
    display: grid;
    grid-template-columns: minmax(150px, 0.32fr) minmax(0, 1fr);
    gap: 56px;
    padding: 60px 0;
    border-top: 1px solid var(--line);
  }

  .section-index {
    margin: 0;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .about-intro p {
    max-width: 680px;
    margin: 0 0 20px;
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.8;
  }

  .about-intro .lead {
    color: var(--ink);
    font-size: clamp(1.45rem, 2.7vw, 2.1rem);
    font-weight: 620;
    letter-spacing: 0;
    line-height: 1.35;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    padding-bottom: 74px;
  }

  .about-grid article {
    min-height: 330px;
    padding: 26px;
    background: rgb(255 255 255 / 0.62);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .about-grid h2 {
    margin: 28px 0 32px;
    font-size: 1.55rem;
    letter-spacing: 0;
  }

  .about-grid ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about-grid li {
    display: flex;
    gap: 10px;
    padding: 13px 0;
    color: var(--muted);
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .about-grid li span {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  .keyword-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .keyword-cloud span {
    padding: 8px 11px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.75rem;
  }

  .contact-panel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    padding: 52px;
    color: white;
    background: var(--ink);
    border-radius: var(--radius);
  }

  .contact-panel .eyebrow {
    color: rgb(255 255 255 / 0.45);
  }

  .contact-panel h2 {
    margin: 24px 0 0;
    font-size: clamp(2.35rem, 4.3vw, 3.7rem);
    letter-spacing: 0;
    line-height: 0.98;
  }

  .contact-links {
    display: grid;
    align-content: end;
  }

  .contact-links a {
    display: grid;
    grid-template-columns: 70px 1fr 20px;
    gap: 12px;
    align-items: center;
    padding: 18px 0;
    border-top: 1px solid rgb(255 255 255 / 0.2);
  }

  .contact-links a:last-child {
    border-bottom: 1px solid rgb(255 255 255 / 0.2);
  }

  .contact-links span {
    color: rgb(255 255 255 / 0.45);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
  }

  .contact-links strong {
    overflow: hidden;
    font-size: 0.84rem;
    font-weight: 550;
    text-overflow: ellipsis;
  }

  .contact-links i {
    color: #ffdc62;
    font-style: normal;
    transition: transform 160ms ease;
  }

  .contact-links a:hover i {
    transform: translate(2px, -2px);
  }

  @media (max-width: 820px) {
    .about-hero {
      grid-template-columns: 1fr;
      min-height: 0;
      padding-bottom: 64px;
    }

    .orbit-decoration {
      justify-self: center;
      width: min(78vw, 300px);
      margin-top: 20px;
    }

    .about-intro {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .about-grid {
      grid-template-columns: 1fr;
    }

    .contact-panel {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }

  @media (max-width: 600px) {
    .about-page {
      padding-top: 32px;
    }

    .about-hero {
      padding-bottom: 48px;
    }

    h1 {
      font-size: clamp(2.6rem, 11.4vw, 3.7rem);
    }

    .about-grid article {
      min-height: 0;
      padding: 21px;
    }

    .contact-panel {
      padding: 28px 20px;
    }

    .contact-links a {
      grid-template-columns: 58px minmax(0, 1fr) 20px;
    }
  }
</style>
