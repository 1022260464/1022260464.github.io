---
import Layout from "../layouts/Layout.astro";
import Spark from "../components/Spark.astro";
import { site } from "../lib/site";
---

<Layout
  title={`关于 — ${site.name}`}
  description="关于这个网站、正在做的事，以及如何联系。"
>
  <div class="page-shell about-page">
    <header class="about-hero">
      <div>
        <p class="eyebrow" data-enter>About / Personal space</p>
        <h1>
          <span data-enter>保持好奇，</span>
          <span data-enter>认真做东西。</span>
        </h1>
      </div>
      <div class="monogram" aria-hidden="true" data-enter>
        <span>0x</span>
        <div class="orbit-system">
          <span class="orbit-ring orbit-ring-inner"></span>
          <span class="orbit-ring orbit-ring-middle"></span>
          <span class="orbit-ring orbit-ring-outer"></span>

          <div class="orbit orbit-one">
            <i class="planet planet-one">
              <span class="planet-graphic">
                <Spark size={10} spin={false} />
              </span>
            </i>
          </div>
          <div class="orbit orbit-two">
            <i class="planet planet-two">
              <span class="planet-graphic">
                <Spark size={13} spin={false} />
              </span>
            </i>
          </div>
          <div class="orbit orbit-three">
            <i class="planet planet-three">
              <span class="planet-graphic">
                <Spark size={8} spin={false} />
              </span>
            </i>
          </div>
          <div class="orbit orbit-four">
            <i class="planet planet-four">
              <span class="planet-graphic">
                <Spark size={11} spin={false} />
              </span>
            </i>
          </div>
          <div class="orbit orbit-five">
            <i class="planet planet-five">
              <span class="planet-graphic">
                <span class="planet-dot planet-dot-warm"></span>
              </span>
            </i>
          </div>
          <div class="orbit orbit-six">
            <i class="planet planet-six">
              <span class="planet-graphic">
                <span class="planet-dot planet-dot-blue"></span>
              </span>
            </i>
          </div>
          <div class="orbit orbit-seven">
            <i class="planet planet-seven">
              <span class="planet-graphic">
                <span class="planet-dot planet-dot-ring"></span>
              </span>
            </i>
          </div>
          <div class="orbit orbit-eight">
            <i class="planet planet-eight">
              <span class="planet-graphic">
                <Spark size={9} spin={false} />
              </span>
            </i>
          </div>

          <i class="monogram-core"><Spark size={30} spin={false} /></i>
        </div>
        <span>330</span>
      </div>
    </header>

    <section class="about-intro" data-reveal>
      <p class="section-index">01 / 关于这里</p>
      <div>
        <p class="lead">
          这是一个用于存放作品、笔记和长期思考的个人空间。
        </p>
        <p>
          我关注设计如何让信息更清楚，也关注代码如何把想法真正做出来。
          这里不会追逐每一个新工具，而会记录那些经过使用、验证和反复回看的经验。
        </p>
      </div>
    </section>

    <section class="about-grid">
      <article data-reveal data-tilt>
        <p class="section-index">02 / 此刻</p>
        <h2>正在做的事</h2>
        <ul>
          <li><span>01</span>重新整理个人网站的内容与结构</li>
          <li><span>02</span>记录前端开发和界面设计中的实践</li>
          <li><span>03</span>把零散想法整理成可以分享的文章</li>
        </ul>
      </article>
      <article data-reveal data-tilt>
        <p class="section-index">03 / 关键词</p>
        <h2>最近关注</h2>
        <div class="keyword-cloud">
          <span>Astro</span>
          <span>Interface</span>
          <span>Typography</span>
          <span>Open source</span>
          <span>Writing</span>
          <span>Tools for thought</span>
        </div>
      </article>
    </section>

    <section class="contact-panel" data-reveal>
      <div>
        <p class="eyebrow">Get in touch</p>
        <h2>有想法，<br />可以聊聊。</h2>
      </div>
      <div class="contact-links">
        <a href={site.email} data-magnetic>
          <span>Email</span>
          <strong>1022260464@qq.com</strong>
          <i>↗</i>
        </a>
        <a href={site.github} target="_blank" rel="noreferrer" data-magnetic>
          <span>GitHub</span>
          <strong>@1022260464</strong>
          <i>↗</i>
        </a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .about-page {
    padding-top: 78px;
  }

  .about-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(220px, 0.6fr);
    gap: 48px;
    align-items: center;
    min-height: 470px;
  }

  h1 {
    margin: 32px 0 0;
    font-size: clamp(4rem, 8vw, 7.2rem);
    font-weight: 750;
    letter-spacing: -0.06em;
    line-height: 0.94;
  }

  h1 span {
    display: block;
  }

  .monogram {
    position: relative;
    display: grid;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.16em;
  }

  .monogram::after {
    position: absolute;
    inset: 11%;
    border: 1px dashed var(--line-strong);
    border-radius: 50%;
    content: "";
  }

  .monogram > span:first-child {
    position: absolute;
    top: 27%;
  }

  .monogram > span:last-child {
    position: absolute;
    bottom: 27%;
  }

  .orbit-system {
    position: relative;
    display: grid;
    width: 72%;
    aspect-ratio: 1;
    place-items: center;
  }

  .orbit-ring {
    position: absolute;
    border: 1px solid rgb(30 30 30 / 0.1);
    border-radius: 50%;
  }

  .orbit-ring-inner {
    inset: 31%;
  }

  .orbit-ring-middle {
    inset: 17%;
    border-style: dashed;
  }

  .orbit-ring-outer {
    inset: 2%;
    border-color: rgb(30 30 30 / 0.07);
  }

  .orbit {
    position: absolute;
    inset: 0;
    animation: orbit-spin var(--orbit-duration) linear infinite;
    animation-delay: var(--orbit-delay);
  }

  .orbit-one {
    --orbit-duration: 26s;
    --orbit-delay: -7s;
  }

  .orbit-two {
    --orbit-duration: 38s;
    --orbit-delay: -24s;
  }

  .orbit-three {
    --orbit-duration: 20s;
    --orbit-delay: -13s;
  }

  .orbit-four {
    --orbit-duration: 33s;
    --orbit-delay: -18s;
  }

  .orbit-five {
    --orbit-duration: 29s;
    --orbit-delay: -9s;
  }

  .orbit-six {
    --orbit-duration: 22s;
    --orbit-delay: -3s;
  }

  .orbit-seven {
    --orbit-duration: 42s;
    --orbit-delay: -31s;
  }

  .orbit-eight {
    --orbit-duration: 17s;
    --orbit-delay: -6s;
  }

  .planet {
    position: absolute;
    top: 50%;
    left: calc(50% + var(--orbit-radius));
    display: grid;
    width: 24px;
    height: 24px;
    place-items: center;
    transform: translate(-50%, -50%);
  }

  .planet-one {
    --orbit-radius: calc(50% - 13px);
  }

  .planet-two {
    --orbit-radius: 31%;
  }

  .planet-three {
    --orbit-radius: 14%;
  }

  .planet-four {
    --orbit-radius: 39%;
  }

  .planet-five {
    --orbit-radius: 24%;
  }

  .planet-six {
    --orbit-radius: 13%;
  }

  .planet-seven {
    --orbit-radius: 43%;
  }

  .planet-eight {
    --orbit-radius: 31%;
  }

  .planet-graphic {
    display: grid;
    animation: orbit-counter-spin var(--orbit-duration) linear infinite;
    animation-delay: var(--orbit-delay);
    place-items: center;
  }

  .planet-dot {
    display: block;
    border-radius: 50%;
    box-shadow: inset -1px -1px 2px rgb(0 0 0 / 0.12);
  }

  .planet-dot-warm {
    width: 12px;
    height: 12px;
    background: radial-gradient(circle at 32% 28%, #fff4c7 0 12%, #ffba63 35%, #f06c76 100%);
  }

  .planet-dot-blue {
    width: 9px;
    height: 9px;
    background: radial-gradient(circle at 34% 27%, #e5fbff 0 12%, #69b9e8 38%, #4d68ce 100%);
  }

  .planet-dot-ring {
    position: relative;
    width: 10px;
    height: 10px;
    background: radial-gradient(circle at 32% 27%, #f6e9ff 0 12%, #b983dc 40%, #6f56bd 100%);
  }

  .planet-dot-ring::after {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 18px;
    height: 5px;
    border: 1px solid rgb(112 81 174 / 0.62);
    border-radius: 50%;
    content: "";
    transform: translate(-50%, -50%) rotate(-18deg);
  }

  .monogram-core {
    display: grid;
    place-items: center;
    color: var(--blue);
    font-style: normal;
  }

  @keyframes orbit-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes orbit-counter-spin {
    to {
      transform: rotate(-360deg);
    }
  }

  .about-intro {
    display: grid;
    grid-template-columns: minmax(150px, 0.32fr) minmax(0, 1fr);
    gap: 56px;
    padding: 60px 0;
    border-top: 1px solid var(--line);
  }

  .section-index {
    margin: 0;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .about-intro p {
    max-width: 680px;
    margin: 0 0 20px;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.8;
  }

  .about-intro .lead {
    color: var(--ink);
    font-size: clamp(1.7rem, 3.2vw, 2.6rem);
    font-weight: 620;
    letter-spacing: -0.035em;
    line-height: 1.35;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    padding-bottom: 74px;
  }

  .about-grid article {
    min-height: 330px;
    padding: 26px;
    background: rgb(255 255 255 / 0.62);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .about-grid h2 {
    margin: 28px 0 32px;
    font-size: 1.7rem;
    letter-spacing: -0.03em;
  }

  .about-grid ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about-grid li {
    display: flex;
    gap: 10px;
    padding: 13px 0;
    color: var(--muted);
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .about-grid li span {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  .keyword-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .keyword-cloud span {
    padding: 8px 11px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.75rem;
  }

  .contact-panel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    padding: 52px;
    color: white;
    background: var(--ink);
    border-radius: var(--radius);
  }

  .contact-panel .eyebrow {
    color: rgb(255 255 255 / 0.45);
  }

  .contact-panel h2 {
    margin: 24px 0 0;
    font-size: clamp(2.6rem, 5vw, 4.2rem);
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .contact-links {
    display: grid;
    align-content: end;
  }

  .contact-links a {
    display: grid;
    grid-template-columns: 70px 1fr 20px;
    gap: 12px;
    align-items: center;
    padding: 18px 0;
    border-top: 1px solid rgb(255 255 255 / 0.2);
  }

  .contact-links a:last-child {
    border-bottom: 1px solid rgb(255 255 255 / 0.2);
  }

  .contact-links span {
    color: rgb(255 255 255 / 0.45);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
  }

  .contact-links strong {
    overflow: hidden;
    font-size: 0.84rem;
    font-weight: 550;
    text-overflow: ellipsis;
  }

  .contact-links i {
    color: #ffdc62;
    font-style: normal;
    transition: transform 160ms ease;
  }

  .contact-links a:hover i {
    transform: translate(2px, -2px);
  }

  @media (max-width: 820px) {
    .about-hero {
      grid-template-columns: 1fr;
      min-height: 0;
      padding-bottom: 64px;
    }

    .monogram {
      display: none;
    }

    .about-intro {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .about-grid {
      grid-template-columns: 1fr;
    }

    .contact-panel {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit,
    .planet-graphic {
      animation: none;
    }
  }

  @media (max-width: 600px) {
    .about-page {
      padding-top: 32px;
    }

    .about-hero {
      padding-bottom: 48px;
    }

    h1 {
      font-size: clamp(3.4rem, 17vw, 5rem);
    }

    .about-grid article {
      min-height: 0;
      padding: 21px;
    }

    .contact-panel {
      padding: 28px 20px;
    }

    .contact-links a {
      grid-template-columns: 58px minmax(0, 1fr) 20px;
    }
  }
</style>
