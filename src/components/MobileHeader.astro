---
import { navigation, site } from "../lib/site";
import Spark from "./Spark.astro";

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="mobile-header">
  <a class="mobile-brand" href="/">
    {site.name}
    <Spark class="mobile-mark" size={14} delay={-3} data-spin />
  </a>
  <details class="mobile-menu">
    <summary>菜单</summary>
    <nav aria-label="移动端导航">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            class:list={{ active: isActive(item.href) }}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            <span>{item.label}</span>
            <span>{item.index}</span>
          </a>
        ))
      }
    </nav>
  </details>
</header>

<style>
  .mobile-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 30;
    display: none;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    padding: 0 var(--page-gutter);
    background: rgb(248 249 246 / 0.92);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(16px);
  }

  .mobile-brand {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.9rem;
    font-weight: 750;
  }

  .mobile-mark {
    color: var(--blue);
    overflow: visible;
  }

  .mobile-menu {
    position: relative;
  }

  .mobile-menu summary {
    padding: 9px 12px;
    background: var(--paper-strong);
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.76rem;
    font-weight: 650;
    cursor: pointer;
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu nav {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    display: grid;
    width: 210px;
    padding: 8px;
    background: var(--paper-strong);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 18px 50px rgb(17 19 15 / 0.12);
  }

  .mobile-menu nav a {
    display: flex;
    justify-content: space-between;
    padding: 11px 10px;
    border-radius: 5px;
    font-size: 0.84rem;
  }

  .mobile-menu nav a:hover,
  .mobile-menu nav a.active {
    background: var(--paper);
  }

  .mobile-menu nav a span:last-child {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }

  @media (max-width: 980px) {
    .mobile-header {
      display: flex;
    }
  }
</style>
