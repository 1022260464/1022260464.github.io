---
interface Props {
  class?: string;
  size?: number;
  delay?: number;
  spin?: boolean;
  [key: string]: unknown;
}

const { class: className, size = 20, delay = 0, spin = true, ...rest } = Astro.props;

const sparkId = crypto.randomUUID().replaceAll("-", "");
const topGradientId = `spark-top-${sparkId}`;
const rightGradientId = `spark-right-${sparkId}`;
const bottomGradientId = `spark-bottom-${sparkId}`;
const leftGradientId = `spark-left-${sparkId}`;
const highlightId = `spark-highlight-${sparkId}`;
---

<svg
  {...rest}
  class:list={["spark-icon", className, { "spark-static": !spin }]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  style={`--spark-delay: ${delay}s`}
>
  <defs>
    <linearGradient id={topGradientId} x1="12" y1="12" x2="12" y2="2">
      <stop stop-color="#4d8dff" />
      <stop offset="1" stop-color="#8c6cff" />
    </linearGradient>
    <linearGradient id={rightGradientId} x1="12" y1="12" x2="22" y2="12">
      <stop stop-color="#8c6cff" />
      <stop offset="1" stop-color="#ed68a8" />
    </linearGradient>
    <linearGradient id={bottomGradientId} x1="12" y1="12" x2="12" y2="22">
      <stop stop-color="#ed68a8" />
      <stop offset="1" stop-color="#ff8b55" />
    </linearGradient>
    <linearGradient id={leftGradientId} x1="12" y1="12" x2="2" y2="12">
      <stop stop-color="#ff8b55" />
      <stop offset="1" stop-color="#ffd75c" />
    </linearGradient>
    <radialGradient id={highlightId} cx="0" cy="0" r="1">
      <stop stop-color="#ffffff" stop-opacity="0.92" />
      <stop offset="0.34" stop-color="#ffffff" stop-opacity="0.28" />
      <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
    </radialGradient>
  </defs>
  <g class="spark-rotor">
    <path
      d="M12 12C9.3 9.6 8.9 4.3 12 2.15C15.1 4.3 14.7 9.6 12 12Z"
      fill={`url(#${topGradientId})`}
    />
    <path
      d="M12 12C14.4 9.3 19.7 8.9 21.85 12C19.7 15.1 14.4 14.7 12 12Z"
      fill={`url(#${rightGradientId})`}
    />
    <path
      d="M12 12C14.7 14.4 15.1 19.7 12 21.85C8.9 19.7 9.3 14.4 12 12Z"
      fill={`url(#${bottomGradientId})`}
    />
    <path
      d="M12 12C9.6 14.7 4.3 15.1 2.15 12C4.3 8.9 9.6 9.3 12 12Z"
      fill={`url(#${leftGradientId})`}
    />
    <circle cx="10.5" cy="9.7" r="2.4" fill={`url(#${highlightId})`} />
  </g>
</svg>

<style>
  .spark-icon {
    flex: none;
    overflow: visible;
    vertical-align: middle;
  }

  .spark-rotor {
    transform-origin: 12px 12px;
    animation: spark-turn 18s linear infinite;
    animation-delay: var(--spark-delay, 0s);
    will-change: transform;
  }

  .spark-static .spark-rotor {
    animation: none;
  }

  @keyframes spark-turn {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .spark-rotor {
      animation: none;
    }
  }
</style>
