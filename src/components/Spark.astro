---
interface Props {
  class?: string;
  size?: number;
  [key: string]: unknown;
}

const { class: className, size = 20, ...rest } = Astro.props;
---

<svg
  {...rest}
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <path
    data-draw
    d="M12 2.5C13 9.2 14.8 11 21.5 12C14.8 13 13 14.8 12 21.5C11 14.8 9.2 13 2.5 12C9.2 11 11 9.2 12 2.5Z"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linejoin="round"
  />
  <circle cx="12" cy="12" r="1.25" fill="currentColor" />
</svg>
